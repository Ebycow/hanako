# docker compose 用の設定。このファイルを .env にコピーして値を入れる

# Discord Bot のトークンと CLIENT_ID（必須）
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# （任意）以前ギルド単位でスラッシュコマンドを登録していた GUILD_ID
DISCORD_GUILD_ID=

# 音声サーバ: Ebyroid に直接つなぐか、ttshub を経由するかのどちらか 1 つを選ぶ
# 構成ごとに必要なものは README の「2.音声サーバの設定」を参照
# 同じマシンで動かしているなら host.docker.internal、別のマシンならその IP アドレスを書く

# Ebyroid に直接つなぐとき。省略すると下の値（同じマシンの Ebyroid の従来の API）になる
# ストリーミングを使うときは /api/v2/audiostream にする（Ebycow/ebyroid が必要。nanokina/ebyroid は v1 のみ）
EBYROID_STREAM_API_URL=http://host.docker.internal:4090/api/v1/audiostream

# ttshub（TTS ゲートウェイ, https://github.com/Ebycow/ttshub）を経由するとき
# 設定すると EBYROID_STREAM_API_URL は使わない
# TTSHUB_URL=http://host.docker.internal:8790

# （任意）help コマンドで案内する使い方のページの URL。省略すると GitHub の README を案内する
# HELP_URL=https://example.com/hanako

# 使うイメージのタグ。本番（deploy.sh で更新する環境）は latest、開発は dev（既定）にする
# 開発で latest にすると、ビルドしたときに本番のイメージを上書きしてしまう
HANAKO_TAG=dev
