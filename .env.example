# docker compose 用の設定。このファイルを .env にコピーして値を入れる

# Discord Bot のトークンと CLIENT_ID（必須）
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# （任意）以前ギルド単位でスラッシュコマンドを登録していた GUILD_ID
DISCORD_GUILD_ID=

# 音声サーバ: ttshub を使うか、Ebyroid に直接つなぐかのどちらか 1 つを選ぶ（README の「音声サーバを用意する」を参照）
# 同じマシンで動かしているなら host.docker.internal、別のマシンならその IP アドレスを書く

# ttshub（https://github.com/Ebycow/ttshub）を使うとき（おすすめ）。設定すると EBYROID_STREAM_API_URL は使わない
# TTSHUB_URL=http://host.docker.internal:8790

# Ebyroid（https://github.com/Ebycow/ebyroid）に直接つなぐとき。VOICEROID だけで読み上げる
# 従来の API しかない音声サーバ（nanokina/ebyroid など）は /api/v1/audiostream にする
EBYROID_STREAM_API_URL=http://host.docker.internal:4090/api/v2/audiostream

# （任意）help コマンドで案内する使い方のページの URL。省略すると GitHub の README を案内する
# HELP_URL=https://example.com/hanako

# 使うイメージのタグ。本番（deploy.sh で更新する環境）は latest、開発は dev（既定）にする
# 開発で latest にすると、ビルドしたときに本番のイメージを上書きしてしまう
HANAKO_TAG=dev
