{
    "appenders": {
        "console": {
            "type": "stdout",
            "layout": { "type": "hanako" }
        },
        "app": {
            "type": "dateFile",
            "filename": "log/app.log",
            "pattern": "yyyy-MM-dd",
            "keepFileExt": true,
            "numBackups": 99999,
            "layout": { "type": "hanako" }
        },
        "errorFile": {
            "type": "dateFile",
            "filename": "log/errors.log",
            "pattern": "yyyy-MM-dd",
            "keepFileExt": true,
            "numBackups": 99999,
            "layout": { "type": "hanako" }
        },
        "errors": {
            "type": "logLevelFilter",
            "level": "ERROR",
            "appender": "errorFile"
        }
    },
    "categories": {
        "default": {
            "appenders": ["console", "app", "errors"],
            "level": "INFO"
        }
    }
}
