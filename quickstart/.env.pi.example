# quickstart/compose.yaml 用の設定（Raspberry Pi など arm64 の小さな機械向け。Open JTalk で読み上げる）
# このファイルを .env にコピーして値を入れる。x64 の PC では .env.example を使う

# Discord Bot のトークンと CLIENT_ID（必須）
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# （任意）以前ギルド単位でスラッシュコマンドを登録していた GUILD_ID
# DISCORD_GUILD_ID=

# 一緒に起動するエンジン（カンマ区切り）。Open JTalk は書かなくても常に起動する
#   voicevox  : VOICEVOX。arm64 でも動くが重い
#   voiceroid : VOICEROID（ebyroid）。ライブラリと ebyroid.conf.json の用意が要る（README の「VOICEROID も使う場合」）
#               動く機種と制約は https://github.com/Ebycow/ebyroid#raspberry-pi-linuxarm64 を参照
# COMPOSE_PROFILES=voiceroid

# サーバでキャラクターを指定していないときの声（ttshub のアドレス）
# Open JTalk の声: openjtalk:mei（normal / angry / bashful / happy / sad）、openjtalk:takumi、openjtalk:nitech-jp-atr503-m001
DEFAULT_VOICE=openjtalk:mei

# （任意）VOICEROID のライブラリを置いた場所。省略すると ./AHS/VOICEROID+
# VOICEROID_DIR=./AHS/VOICEROID+

# （任意）VOICEROID のワーカー数（既定 3）。メモリが 1GB の機種（Raspberry Pi 3 など）は 1 にする
# EBYROID_WORKERS=1

# （任意）help コマンドで案内する使い方のページの URL。省略すると GitHub の README を案内する
# HELP_URL=https://example.com/hanako

# （任意）使うイメージの版。省略すると最新（latest）。戻したいときはコミット ID を書く
# TTSHUB_VERSION は Open JTalk のサーバーにも使う
# HANAKO_VERSION=latest
# TTSHUB_VERSION=latest
# EBYROID_VERSION=latest
