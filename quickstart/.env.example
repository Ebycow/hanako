# quickstart/compose.yaml 用の設定。このファイルを .env にコピーして値を入れる

# Discord Bot のトークンと CLIENT_ID（必須）
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# （任意）以前ギルド単位でスラッシュコマンドを登録していた GUILD_ID
# DISCORD_GUILD_ID=

# （任意）サーバでキャラクターを指定していないときの声（ttshub のアドレス）
# DEFAULT_VOICE=voicevox:ずんだもん

# （任意）VOICEROID も使うときは、次の行を有効にして ebyroid を一緒に起動する
# VOICEROID のライブラリ（Windows の C:\Program Files (x86)\AHS\VOICEROID+）を VOICEROID_DIR に置き、
# ebyroid.conf.example.json を ebyroid.conf.json にコピーして使う声を書く
# COMPOSE_PROFILES=voiceroid
# VOICEROID_DIR=./AHS/VOICEROID+

# （任意）help コマンドで案内する使い方のページの URL。省略すると GitHub の README を案内する
# HELP_URL=https://example.com/hanako

# （任意）使うイメージの版。省略すると最新（latest）。戻したいときはコミット ID を書く
# HANAKO_VERSION=latest
# TTSHUB_VERSION=latest
# EBYROID_VERSION=latest
